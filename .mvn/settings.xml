<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">

	<localRepository>${env.WORKSPACE}/.mvn/repo</localRepository>

	<mirrors>
		<mirror>
			<id>maven-central-mirror</id>
			<mirrorOf>central</mirrorOf>
			<name>Local Mirror: Maven Central</name>
			<url>${env.MVN_PROXY_central_URL}</url>
		</mirror>
		<mirror>
			<id>rnet-releases-mirror</id>
			<mirrorOf>runeduniverse-releases</mirrorOf>
			<name>Local Mirror: rnet-releases</name>
			<url>${env.MVN_PROXY_rnet_releases_URL}</url>
		</mirror>
		<mirror>
			<id>rnet-development-mirror</id>
			<mirrorOf>runeduniverse-development</mirrorOf>
			<name>Local Mirror: rnet-development</name>
			<url>${env.MVN_PROXY_rnet_development_URL}</url>
		</mirror>
	</mirrors>

</settings>
